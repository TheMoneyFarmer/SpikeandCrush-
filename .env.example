# Spike & Crush environment variables.
# Copy to .env for local development. NEVER put real production values in a
# committed file: production values live only in Railway > service > Variables.
#
# REQ  = required in production (the server refuses to start without it, see server/envCheck.js)
# REC  = recommended (a feature switches off or falls back without it; a warning is logged)
# OPT  = optional tuning (sensible default in code)
# Both servers read the same names; [game] / [admin] / [both] says which uses it.

# ---- Database (Supabase) -------------------------------------------------------
SUPABASE_URL=                 # REQ [both] project URL, https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=         # REQ [both] service role key. Server only, never in the browser
SUPABASE_ANON_KEY=            # REQ [game] public anon key, sent to the browser for sign-in
SUPABASE_SECRET_KEY=          # OPT [game] new-style secret key; lets auth forward the visitor IP to Supabase rate limits
DB_TIMEOUT_MS=                # OPT [game] Supabase request timeout, default 15000
DB_MAX_CONCURRENT=            # OPT [game] parallel DB calls before queueing
DB_QUEUE_TIMEOUT_MS=          # OPT [game] how long a queued DB call may wait

# ---- Site and network ----------------------------------------------------------
NODE_ENV=development          # REQ [both] "production" on Railway (turns on the strict checks)
PORT=3000                     # OPT [game] game server port (Railway sets it)
ADMIN_PORT=3003               # OPT [admin] admin server port locally
ALLOWED_ORIGIN=               # REQ [game] comma-separated exact site origins for CORS and sockets (production)
SITE_URL=                     # REC [game] public site URL used in emails and links
TRUST_PROXY_HOPS=             # OPT [both] proxy hops in front of the server (Railway 1, + Cloudflare 2)
ORIGIN_LOCK=                  # OPT [both] "on" = only accept traffic through Cloudflare
ORIGIN_SECRET=                # OPT [both] shared header value Cloudflare adds when ORIGIN_LOCK is on
API_RATE_LIMIT=               # OPT [game] API requests per IP per 15 minutes, default 1500
AUTH_RATE_LIMIT=              # OPT [game] auth requests per IP per 15 minutes, default 100
MAX_LIVE_MATCHES=             # OPT [game] cap on matches running at once

# ---- Admin panel ---------------------------------------------------------------
ADMIN_USERNAME=               # REQ [admin] shared admin login name
ADMIN_PASSWORD=               # REQ [admin] shared admin login password (16+ characters)
ADMIN_SECRET=                 # REQ [admin] signs admin session tokens (64 random characters)
MASTER_ADMIN_PASSWORD=        # REC [admin] password synced to the super-admin account (16+ characters)
ADMIN_REQUIRE_2FA=            # REC [admin] "1" = every admin must use an authenticator code
ADMIN_ALLOWED_IPS=            # OPT [admin] optional IP allowlist (comma-separated)
INTERNAL_ADMIN_SECRET=        # REC [both] shared secret for the admin -> game server bridge
GAME_SERVER_INTERNAL_URL=     # REC [admin] game server URL the bridge calls
ADMIN_URL=                    # OPT [admin] public admin URL used in sponsor emails
ADMIN_INTERNAL_URL=           # OPT [game] admin URL the support bridge calls
ADMIN_PUBLIC_URL=             # OPT [game] admin URL put in support notification emails
SUPPORT_BRIDGE_ALLOW_REMOTE=  # OPT [game] "1" lets the support bridge accept non-loopback callers

# ---- Signing and hashing keys (64 random characters each) ----------------------
CHALLENGE_SECRET=             # REC [game] signs challenge links (falls back to JWT_SECRET, then a key derived from the service key)
JWT_SECRET=                   # OPT [game] older name for the challenge-link key
STATEMENT_SECRET=             # REC [both] signs account statements (falls back to INTERNAL_ADMIN_SECRET, ADMIN_SECRET, then derived)
IP_HASH_SECRET=               # REC [game] salt for hashed visitor IPs in sponsor stats
LISTING_SECRETS_KEY=          # REC [both] encrypts partner outbound links and codes at rest
DEPLOY_DRAIN_TOKEN=           # REC [game] lets the CI deploy gate pause new matches (same value as the GitHub secret)

# ---- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=               # REC [both] without it no emails are sent and email verification is off
RESEND_FROM_EMAIL=            # OPT [both] sender address
EMAIL_VERIFICATION=           # OPT [game] "off" = kill switch for email verification
ALERT_EMAIL=                  # OPT [game] where server alerts go, default hello@spikeandcrush.com
FIRE_ALERT_EMAIL=             # OPT [game] where market-data alerts go
SUPPORT_NOTIFY_EMAIL=         # OPT [game] where new support tickets are announced
SUPPORT_EMAIL_DRY_RUN=        # OPT [game] "1" = log support emails instead of sending

# ---- Support chat (Claude API) -------------------------------------------------
ANTHROPIC_API_KEY=            # REC [game] without it every support message goes to a human
SUPPORT_MODEL=                # OPT [game] model id for the support agent
SUPPORT_AI_PER_HOUR=          # OPT [game] AI answers per account or guest per hour, default 30
SUPPORT_DAILY_TOKEN_CAP=      # OPT [game] tokens across all support chats per UTC day, default 4000000
SUPPORT_FIRST_RESPONSE_MINUTES= # OPT [game] SLA before the "still waiting" note
SUPPORT_SITE_URL=             # OPT [game] site URL used in support emails

# ---- Bot protection, Discord, analytics -----------------------------------------
TURNSTILE_SITE_KEY=           # OPT [game] Cloudflare Turnstile public key (sign-up)
TURNSTILE_SECRET_KEY=         # OPT [game] Cloudflare Turnstile secret
DISCORD_CLIENT_ID=            # OPT [game] Discord account linking
DISCORD_CLIENT_SECRET=        # OPT [game]
DISCORD_BOT_TOKEN=            # OPT [game]
DISCORD_SERVER_ID=            # OPT [game]
DISCORD_MEMBER_ROLE_ID=       # OPT [game]
ANALYTICS_PROVIDER=           # OPT [game] "plausible" or "ga4"
ANALYTICS_ID=                 # OPT [game] analytics site id

# ---- Legal and company details (shown on legal pages) --------------------------
COMPANY_LEGAL_NAME=           # OPT [game]
COMPANY_ADDRESS=              # OPT [game]
COMPANY_REG_NO=               # OPT [game]
GOVERNING_LAW=                # OPT [game]
MINIMUM_AGE=                  # OPT [game]
LEGAL_REVIEWED=               # OPT [game] "true" once a lawyer has reviewed the legal pages

# ---- Deploys and lobbies -------------------------------------------------------
DEPLOY_LOBBY_GRACE_SECONDS=   # OPT [game]
DEPLOY_SETTLE_SECONDS=        # OPT [game]
RAILWAY_DEPLOYMENT_DRAINING_SECONDS= # OPT [game] set by Railway
LOBBY_IDLE_SECONDS=           # OPT [game]
LOBBY_MAX_AGE_MINUTES=        # OPT [game]

# ---- Scripts and tests only (never needed by a running server) -------------------
# SMOKE_BASE SMOKE_USER SMOKE_PASS SMOKE_ADMIN SMOKE_ADMIN_USER SMOKE_ADMIN_PASS SMOKE_JSON SMOKE_SHOTS
# SHOT_BASE SHOT_DIR SHOT_MODE SHOT_USER SHOT_PASS SHOT_SIZES SHOT_WAIT_MS TOUR_BASE TOUR_USER TOUR_PASS
# LOAD_TEST_PORT TARGET SOAK_MINUTES MINUTES EVENTS FLAT_N GAME ADMIN ACCTS COMP_ID DETAIL_PATH ADMIN_PAGES
