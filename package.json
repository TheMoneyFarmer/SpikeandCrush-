{
  "name": "spikecrush",
  "version": "1.0.0",
  "description": "Spike & Crush — The competitive trading game. Up. Then not.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "start:admin": "node admin/server.js",
    "start:all": "concurrently \"npm start\" \"PORT=3003 npm run start:admin\"",
    "generate-data": "node data/dataProcessor.js",
    "data:fetch": "node scripts/fetch-market-data.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dukascopy-node": "^1.51.1"
  }
